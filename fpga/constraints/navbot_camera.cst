IO_LOC "debug_rx" C18;
IO_PORT "debug_tx" IO_TYPE=LVCMOS33;
IO_PORT "debug_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// Navigation module: P6 3=RX (F14), P6 5=TX idle-high (D17).
IO_LOC "nav_rx" F14;
