// Keep the FIFO reset distributor at the location verified in the previous
// passing layout. It releases on the falling edge of the 150 MHz read clock,
// leaving a 3.333 ns half cycle for its 55 rising-edge reset consumers.
INS_LOC "camera/Video_Frame_Buffer_Top/vfb_ddr3_wrapper_inst/u0_dma_frame_buffer/u_dma_read_ctrl/fifo_read_inst/reset_r_1_s0" R27C12[1][A];
