// ACG525-CORE page 3 + ACG525-CB pages 2/5: BANK4/5=3.3 V,
// BANK2/3=3.3 V, BANK0/1=1.5 V; KEY0..2 pull up to VCCIO01.
// Verified against the supplied ACG525 workbook and its P6 drawing.
// Board top: navbot_camera_top. Do not apply to the internal motion core.
IO_LOC "clk" T9;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_LOC "key_n[0]" B16;
IO_LOC "key_n[1]" A15;
IO_LOC "key_n[2]" C15;
IO_PORT "key_n[0]" IO_TYPE=LVCMOS15 BANK_VCCIO=1.5;
IO_PORT "key_n[1]" IO_TYPE=LVCMOS15 BANK_VCCIO=1.5;
IO_PORT "key_n[2]" IO_TYPE=LVCMOS15 BANK_VCCIO=1.5;
