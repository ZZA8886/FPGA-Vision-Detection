IO_PORT "servo_pwm[0]" IO_TYPE=LVCMOS33;
IO_PORT "servo_pwm[1]" IO_TYPE=LVCMOS33;
// P6 39 TX,37 RX;35 RX,33 TX (wireless command link);36 TX,34 RX
